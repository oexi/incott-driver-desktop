{
  "name": "incott-driver-desktop",
  "productName": "Incott Driver",
  "version": "1.0.2",
  "description": "INCOTT 鼠标桌面驱动（基于官方 WebHID 网页驱动移植）",
  "author": {
    "name": "oexi",
    "email": "oexi@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/oexi/incott-driver-desktop",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:web": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:linux": "vite build && electron-builder --linux --x64 --arm64",
    "dist:win": "vite build && electron-builder --win --x64 --arm64",
    "dist:mac": "vite build && electron-builder --mac --x64 --arm64",
    "test": "node --test tests/*.test.mjs",
    "web": "vite"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "lucide-vue-next": "0.544.0",
    "vite": "7.1.5",
    "vue": "3.5.21"
  }
}
